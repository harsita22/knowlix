# Environment configuration for Knowlix
# Gemini API key (Required): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database configuration (PostgreSQL)
# For local dev / testing, falls back to sqlite:///./knowlix.db if not provided
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowlix

# Security & Authentication
JWT_SECRET=knowlix-super-secret-development-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Folder with theme / curriculum / benchmark data files. Defaults to ./data.
AGENTX_DATA_DIR=./data
